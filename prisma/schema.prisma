generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  engineType             = "client"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

model Qualification {
  id          Int     @id @default(autoincrement())
  publicId    String  @unique(map: "qualifications_public_id_unique") @default(uuid(7)) @map("public_id") @db.VarChar(36)
  subfieldId  Int     @map("subfield_id")
  title       String? @db.VarChar(255)
  name        String? @db.VarChar(255)
  code        String? @unique(map: "qualifications_code_unique") @db.VarChar(30)
  description String? @db.Text
  sortOrder   Int?    @map("sort_order")
  specUrl     String  @map("spec_url") @db.VarChar(255)
  level       Int?
  certificate String?

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)
  userId    Int       @map("user_id")
  user      User?     @relation(fields: [userId], references: [id])

  subfield Subfield @relation(fields: [subfieldId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "qualifications_subfield_id_subfields_id_fk")

  @@map("qualifications")
}

model Field {
  id          Int     @id @default(autoincrement())
  publicId    String  @unique(map: "fields_public_id_unique") @map("public_id") @db.VarChar(36)
  name        String  @db.VarChar(255)
  code        String  @unique(map: "fields_code_unique") @db.VarChar(5)
  description String? @db.VarChar(255)
  sortOrder   Int?    @map("sort_order")
  icon        String? @db.VarChar(255)

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  subfields Subfield[]

  @@unique([deletedAt, code], map: "fields_deleted_at_code_unique")
  @@map("fields")
}

model Subfield {
  id          Int     @id @default(autoincrement())
  publicId    String? @unique(map: "subfields_public_id_unique") @map("public_id") @db.VarChar(36)
  name        String? @unique(map: "subfields_name_unique") @db.VarChar(255)
  code        String?
  description String? @db.VarChar(255)
  sortOrder   Int?    @map("sort_order")

  fieldId Int @map("field_id")

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  qualifications Qualification[]
  field          Field           @relation(fields: [fieldId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "subfields_field_id_fields_id_fk")

  @@unique([code, fieldId], map: "subfields_code_field_id_unique")
  @@map("subfields")
}

model User {
  id             Int             @id @default(autoincrement())
  name           String?         @db.VarChar(255)
  publicId       String?         @unique(map: "user_public_id_unique") @map("public_id") @db.VarChar(36)
  email          String          @unique(map: "user_email_unique")
  passwordHash   String          @default("$argon2id$v=19$m=65536,t=3,p=4$5E1YqD/pmib3gFpNDJy6JQ$xnUXO3lrIVZmD6oDswkKbUQakQfIGdfXLFjdXJjv03I") @map("password_hash") @db.VarChar(255)
  qualifications Qualification[]
  role           UserRole        @default(MANAGER)
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime?       @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamp(6)

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
}
