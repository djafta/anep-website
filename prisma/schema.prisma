// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Qualification {
  id          Int                   @id @default(autoincrement())
  publicId    String                @unique @default(uuid(7)) @map("public_id")
  name        String                @unique
  description String?
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  categoryId  Int                   @map("category_id")
  category    QualificationCategory @relation(fields: [categoryId], references: [id])
  levelId     Int                   @map("level_id")
  level       QualificationLevel    @relation(fields: [levelId], references: [id])

  @@map("qualifications")
}

model QualificationCategory {
  id             Int             @id @default(autoincrement())
  publicId       String          @unique @default(uuid(7)) @map("public_id")
  name           String          @unique
  description    String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  qualifications Qualification[]

  @@map("qualification_categories")
}

model QualificationLevel {
  id             Int             @id @default(autoincrement())
  publicId       String          @unique @default(uuid(7)) @map("public_id")
  name           String          @unique
  description    String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  qualifications Qualification[]

  @@map("qualification_levels")
}
